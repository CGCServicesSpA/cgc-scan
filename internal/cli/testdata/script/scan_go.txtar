# Escaneo de extremo a extremo sobre un proyecto Go vulnerable. El comando
# scanjson ejecuta el escaneo dos veces, valida contra el esquema y comprueba
# la reproducibilidad fuera de la sección run.
scanjson $WORK/report.json $WORK/fixture

-- fixture/go.mod --
module example.com/vulnapp

go 1.24

require golang.org/x/text v0.3.0
